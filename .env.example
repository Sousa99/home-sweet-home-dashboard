# GitHub Packages token — required to install @sousa99/* packages and to build
# the Docker image (scoped packages come from npm.pkg.github.com).
# Create one at https://github.com/settings/tokens with read:packages scope.
# Local installs reuse the token already present in ~/.npmrc if set.
GH_PACKAGES_TOKEN=

# Host port for the dashboard container (mapped to :80).
HSH_DASHBOARD_PORT=3304

# Per-module backend image tags (GHCR). Each module is pinned independently —
# bump one without touching the others. Defaults match the current components
# package versions (see docs/versions.md).
HSH_BUS_CATCHER_BACKEND_VERSION=0.1.3
HSH_FLY_OVER_TRACKER_BACKEND_VERSION=0.4.3
HSH_PROCRASTINATOR_TRACKER_BACKEND_VERSION=0.2.0
HSH_WEATHER_PSYCHIC_BACKEND_VERSION=0.1.0

# Platform for the backend images. The published module images are linux/amd64
# only, so on arm64 hosts (e.g. Apple Silicon) they run under emulation.
HSH_BACKEND_PLATFORM=linux/amd64

# MCP server host ports (streamable HTTP at /mcp) — used by opencode.json.
HSH_BUS_CATCHER_MCP_PORT=3200
HSH_FLY_OVER_TRACKER_MCP_PORT=3201
HSH_PROCRASTINATOR_TRACKER_MCP_PORT=3202
HSH_WEATHER_PSYCHIC_MCP_PORT=3203